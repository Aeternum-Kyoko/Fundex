DATABASE_PATH=data/arbradar.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_IDS=[]
TELEGRAM_MIN_SPREAD_PERCENT=0.5
TELEGRAM_TOP_N=5
TELEGRAM_COOLDOWN_MINUTES=30
TELEGRAM_POLL_INTERVAL_SECONDS=8
