APP_NAME=ArbRadar API
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DEFAULT_POLL_INTERVAL_SECONDS=12
DEFAULT_HISTORY_LIMIT=48
MIN_CONFIDENCE_SCORE=0.35
MIN_COMBINED_OI_USD=500000
MAX_PRICE_DISLOCATION_PERCENT=0.75

BINANCE_ENABLED=true
DELTA_ENABLED=true
COINDCX_ENABLED=false
COINDCX_API_KEY=
COINDCX_SECRET_KEY=
COINSWITCH_ENABLED=false
COINSWITCH_API_KEY=
COINSWITCH_SECRET_KEY=
COINSWITCH_EXCHANGE=EXCHANGE_2

DATABASE_PATH=data/arbradar.db

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_IDS=[]
TELEGRAM_MIN_SPREAD_PERCENT=0.5
TELEGRAM_MIN_CONFIDENCE_SCORE=0.55
TELEGRAM_MIN_COMBINED_OI_USD=1000000
TELEGRAM_MAX_STALENESS_SECONDS=45
TELEGRAM_TOP_N=5
TELEGRAM_COOLDOWN_MINUTES=30
TELEGRAM_POLL_INTERVAL_SECONDS=8
TELEGRAM_DAILY_SUMMARY_ENABLED=true
TELEGRAM_DAILY_SUMMARY_TIMEZONE=Asia/Kolkata
TELEGRAM_DAILY_SUMMARY_TOP_N=5
TELEGRAM_MORNING_SUMMARY_ENABLED=true
TELEGRAM_MORNING_SUMMARY_HOUR=9
TELEGRAM_MORNING_SUMMARY_MINUTE=0
TELEGRAM_EVENING_SUMMARY_ENABLED=true
TELEGRAM_EVENING_SUMMARY_HOUR=18
TELEGRAM_EVENING_SUMMARY_MINUTE=0
TELEGRAM_NIGHT_SUMMARY_ENABLED=true
TELEGRAM_NIGHT_SUMMARY_HOUR=22
TELEGRAM_NIGHT_SUMMARY_MINUTE=0

RETENTION_PRUNE_INTERVAL_MINUTES=5
FUNDING_SNAPSHOT_RETENTION_HOURS=6
OPPORTUNITY_HISTORY_RETENTION_DAYS=1
TELEGRAM_ALERT_STATE_RETENTION_DAYS=30
