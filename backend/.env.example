APP_NAME=ArbRadar API
APP_ENV=development
BINANCE_ENABLED=true
DELTA_ENABLED=true
COINDCX_ENABLED=false
COINSWITCH_ENABLED=false
DEFAULT_POLL_INTERVAL_SECONDS=12
DEFAULT_HISTORY_LIMIT=48
