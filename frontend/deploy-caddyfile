{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# API and the live-update stream go to the backend container.
	handle /api/* {
		reverse_proxy backend:8000 {
			# Server-sent events must not be buffered.
			flush_interval -1
		}
	}

	# The service worker and manifest must never be served stale, or updates won't reach installed copies.
	@shell path /sw.js /manifest.webmanifest
	header @shell Cache-Control "no-cache"
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else is the single-page app.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
